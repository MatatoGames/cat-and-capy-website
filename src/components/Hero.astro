---
import { Picture } from "astro:assets";
import keyart from "../assets/img/keyart.png";
import StoreButtons from "./StoreButtons.astro";
---

<section class="hero" aria-label="Cat & Capy">
  <div class="hero__art" data-pop-zone>
    <Picture
      src={keyart}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 960px) 55vw, 100vw"
      alt="Cat & Capy key art: the capybara and a crowd of cats with hats, a shopping cart and a pelican, around the game's logo"
      loading="eager"
      fetchpriority="high"
    />
    <span class="hero__hint" aria-hidden="true">👆 Tap the picture!</span>
  </div>

  <div class="hero__card" id="play">
    <p class="eyebrow">From the viral video series</p>
    <h1>Cat &amp; Capy, <span class="hl">together</span> on a big 3D adventure.</h1>
    <p class="lede">Ride on each other, rescue animals, and take on the nefarious bird army across colorful worlds. Play solo or in couch co-op.</p>
    <StoreButtons />
    <p class="platforms">Windows · macOS · iPhone &amp; iPad · Android</p>
  </div>
</section>

<script>
  import { cats, stickerImage } from "../lib/cats";
  import { meow } from "../lib/sound";

  const zone = document.querySelector<HTMLElement>("[data-pop-zone]");
  const hint = zone?.querySelector<HTMLElement>(".hero__hint");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const MAX_ON_SCREEN = 12;
  // Go through the cast in order (starting somewhere random) so every tap shows a new cat
  let nextCat = Math.floor(Math.random() * cats.length);

  // Clicking the key art launches a random cat out of the picture
  zone?.addEventListener("click", (e) => {
    hint?.remove();
    if (zone.querySelectorAll(".popcat").length >= MAX_ON_SCREEN) return;

    const cat = cats[nextCat]!;
    nextCat = (nextCat + 1) % cats.length;
    const rect = zone.getBoundingClientRect();
    const img = document.createElement("img");
    img.src = stickerImage(cat.id);
    img.alt = "";
    img.className = "popcat";
    img.style.left = `${e.clientX - rect.left}px`;
    img.style.top = `${e.clientY - rect.top}px`;
    zone.append(img);
    meow(cat.pitch, cat.voice);

    if (reduceMotion) {
      img.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 900 }).finished.then(() => img.remove());
      return;
    }
    // Pop up at the tap, wiggle briefly so you can see who it is, then tumble away
    const dir = Math.random() < 0.5 ? -1 : 1;
    const dx = dir * (60 + Math.random() * 120);
    const spin = dir * (90 + Math.random() * 180);
    const at = (x: number, y: number, s: number, r: number) =>
      `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(${s}) rotate(${r}deg)`;
    img
      .animate(
        [
          { transform: at(0, 0, 0.2, 0), easing: "cubic-bezier(.3,1.6,.5,1)" },
          { transform: at(0, -50, 1.1, 0), offset: 0.18 },
          { transform: at(0, -56, 1, -6), offset: 0.3 },
          { transform: at(0, -58, 1, 0), offset: 0.38, easing: "cubic-bezier(.5,0,.9,.6)" },
          { transform: at(dx, rect.height, 0.9, spin), opacity: 0.85 },
        ],
        { duration: 2000 },
      )
      .finished.then(() => img.remove());
  });
</script>

<style>
  .hero { background: var(--navy); position: relative; padding-bottom: clamp(48px, 8vw, 96px); }
  .hero__art { position: relative; overflow: hidden; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .hero__art :global(img) { width: 100%; max-height: 86vh; object-fit: cover; object-position: center 40%; }
  .hero__art::after {
    content: ""; position: absolute; inset: auto 0 0 0; height: 30%;
    background: linear-gradient(to bottom, transparent, var(--navy));
    pointer-events: none;
  }
  .hero__art :global(.popcat) {
    position: absolute; width: clamp(100px, 14vw, 175px); max-height: none; pointer-events: none; z-index: 3;
    filter: drop-shadow(0 6px 6px rgba(0, 0, 0, .35));
  }
  .hero__hint {
    position: absolute; z-index: 2; left: 50%; bottom: clamp(48px, 12vw, 150px); translate: -50% 0;
    background: rgba(255, 255, 255, .9); color: var(--navy); border: 2px solid var(--navy);
    font: 400 1rem var(--display); padding: 6px 14px; border-radius: 999px; pointer-events: none;
    animation: nudge 1.6s ease-in-out infinite;
  }
  @keyframes nudge { 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .hero__hint { animation: none; } }

  .hero__card {
    position: relative; z-index: 4;
    width: min(880px, 100% - 32px); margin: clamp(-120px, -9vw, -40px) auto 0;
    background: var(--cream); border: 3px solid var(--navy); border-radius: 28px;
    padding: clamp(24px, 5vw, 48px);
    box-shadow: 0 8px 0 var(--berry), 0 24px 60px rgba(0, 0, 0, .35);
    text-align: center;
  }
  .hero__card h1 { font-size: clamp(1.9rem, 4.6vw, 3.2rem); color: var(--navy); }
  .hero__card .lede { max-width: 38em; margin-inline: auto; }
  .platforms { margin: 18px 0 0; font-weight: 800; font-size: .85rem; letter-spacing: .06em; color: var(--ink-soft); }

  /* Desktop: text and stores on the left, framed key art on the right, all above the fold */
  @media (min-width: 960px) {
    .hero {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: center;
      gap: clamp(32px, 4vw, 64px);
      padding: clamp(40px, 6vh, 72px) max(32px, (100vw - 1240px) / 2) clamp(48px, 8vh, 88px);
      background: radial-gradient(60% 80% at 75% 40%, rgba(240, 122, 43, .28), transparent 70%), var(--navy);
    }
    .hero__art {
      order: 2; border-radius: 24px; border: 3px solid var(--sun);
      box-shadow: 0 8px 0 var(--orange), 0 30px 80px rgba(0, 0, 0, .45);
      rotate: 1.2deg; transition: rotate .3s;
    }
    .hero__art:hover { rotate: 0deg; }
    .hero__art :global(img) { max-height: none; aspect-ratio: 16 / 9; }
    .hero__art::after { display: none; }
    .hero__hint { bottom: 16px; }

    .hero__card {
      order: 1; width: auto; margin: 0; padding: 0; text-align: left;
      background: none; border: 0; box-shadow: none;
    }
    .hero__card :global(.eyebrow) { color: var(--sun); }
    .hero__card h1 { color: #fff; font-size: clamp(2.1rem, 3.3vw, 3rem); }
    .hero__card .lede { color: rgba(255, 255, 255, .78); margin-inline: 0; }
    .hero__card :global(.stores) { justify-content: flex-start; gap: 10px; }
    .hero__card :global(.store) { padding: 8px 14px 8px 12px; gap: 8px; }
    .hero__card :global(.store svg) { width: 24px; height: 24px; }
    .hero__card :global(.store span) { font-size: 1.12rem; }
    .hero__card :global(.store) { min-width: 0; border-color: rgba(255, 255, 255, .28); background: var(--navy-2); }
    .hero__card :global(.store--steam) { background: linear-gradient(135deg, #1b2838, #2a475e); }
    .platforms { color: rgba(255, 255, 255, .55); }
  }
</style>
