---
import { icons, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  <path fill="currentColor" d={icons[name]} />
</svg>
