---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CatBand from "../components/CatBand.svelte";
import NewsletterSignup from "../components/NewsletterSignup.svelte";
import { newsletterEnabled } from "../lib/newsletter";
import mascot from "../assets/img/mascot.png";
---

<Base
  title="Rhythm Cat & Capy · Early access"
  description="A Cat & Capy rhythm game is coming to mobile. Sign up for a chance to play it before anyone else."
>
  <main id="main" class="rhythm">
    <a class="home" href="/" aria-label="Cat & Capy home">
      <Image src={mascot} alt="" width={34} densities={[1, 2]} />
      <span>Cat &amp; Capy</span>
    </a>

    <p class="eyebrow">Coming to mobile</p>
    <h1>Rhythm <span class="nowrap">Cat &amp; Capy</span></h1>
    <p class="lede">Tap to the beat with the cats from the videos. Sign up for a chance to play it <strong>before anyone else</strong>.</p>

    <CatBand client:visible />

    <div class="form">
      {newsletterEnabled ? (
        <NewsletterSignup client:load variant="compact" cta="Get early access" />
      ) : (
        <p class="soon">Early access signups open soon. Until then, <a href="https://discord.gg/m6xQkB4Da9">join the Discord</a> for news.</p>
      )}
    </div>

    <p class="more">Want more cats now? <a href="/links">Play our other games →</a></p>
  </main>
</Base>

<style>
  :global(body) {
    background:
      radial-gradient(90% 50% at 50% 0%, rgba(255, 211, 78, .25), transparent 70%),
      linear-gradient(180deg, #4b2a8a 0%, #2c1d5c 60%, var(--navy) 100%);
    min-height: 100dvh;
  }
  .rhythm {
    width: min(560px, 100% - 32px); margin: 0 auto; padding: 24px 0 48px;
    text-align: center; color: #fff;
  }
  .home {
    display: flex; justify-content: center; width: fit-content; margin-inline: auto; align-items: center; gap: 8px; text-decoration: none;
    font: 400 1.15rem var(--display); color: var(--sun); margin-bottom: 28px;
  }
  .home :global(img) { width: 34px; height: auto; }
  .eyebrow { display: block; color: var(--sun); }
  .nowrap { white-space: nowrap; }
  h1 {
    font-size: clamp(2.6rem, 11vw, 4rem); margin: 0 0 12px;
    color: var(--sun); text-shadow: 0 4px 0 var(--berry), 0 8px 0 rgba(0, 0, 0, .25);
  }
  .lede { color: rgba(255, 255, 255, .85); margin-bottom: 28px; }
  .lede strong { color: #fff; }
  .form { margin-top: 28px; }
  .soon { background: rgba(255, 255, 255, .1); border-radius: 18px; padding: 18px; font-weight: 700; }
  .soon a, .more a { color: var(--sun); font-weight: 800; }
  .more { margin-top: 28px; font-weight: 700; color: rgba(255, 255, 255, .75); }
</style>
